{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyInterface": "off",
        "noTemplateCurlyInString": "off"
      },
      "a11y": "off"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":PACKAGE:"],
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"],
              ":BLANK_LINE:",
              [":BUN:", ":NODE:"]
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["biome.json"],
      "formatter": {
        "lineWidth": 80
      }
    },
    {
      "includes": ["packages/mock/src/vocabulary.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "packages/fraq/src/protocol/types.ts",
        "plugins/ai/src/protocol/types-zod.ts"
      ],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    },
    {
      "includes": [
        "docs/**",
        "!docs/.next",
        "!docs/dist",
        "!docs/build",
        "!docs/.source"
      ],
      "linter": {
        "domains": {
          "next": "recommended",
          "react": "recommended"
        }
      }
    },
    {
      "includes": ["docs/**/meta.json"],
      "formatter": {
        "expand": "always"
      }
    },
    {
      "includes": ["plugins/webui-gateway/webui/**/*.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    }
  ]
}
